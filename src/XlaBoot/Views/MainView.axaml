<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:XlaBoot.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XlaBoot.ViewModels"
             xmlns:views="using:XlaBoot.Views"
             mc:Ignorable="d" d:DesignWidth="412" d:DesignHeight="915"
             x:Class="XlaBoot.Views.MainView"
             x:DataType="vm:MainViewModel"
             Foreground="{StaticResource XlaTextBrush}">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>

  <!-- The checkboxes are Buttons drawn as checkboxes, not CheckBox controls: Avalonia.Android's
       ToggleNodeInfoProvider throws when any accessibility client (TalkBack, autofill, uiautomator)
       reads a toggle control, killing the app. -->
  <UserControl.Styles>
    <Style Selector="Button.check">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,6"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.check:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.check:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Border.box">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="{StaticResource XlaTextDimBrush}"/>
    </Style>
    <Style Selector="Border.box.checked">
      <Setter Property="Background" Value="{StaticResource XlaAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource XlaAccentBrush}"/>
    </Style>
    <Style Selector="Path.tick">
      <Setter Property="Data" Value="M 4,11 L 9,16 L 18,6"/>
      <Setter Property="Stroke" Value="White"/>
      <Setter Property="StrokeThickness" Value="2.5"/>
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Stretch" Value="Uniform"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource XlaTextDimBrush}"/>
      <Setter Property="Margin" Value="4,0,0,6"/>
    </Style>
    <Style Selector="Button.card.missing Border.tile > PathIcon">
      <Setter Property="Foreground" Value="#F0B429"/>
    </Style>
    <Style Selector="Button.kofi">
      <Setter Property="Background" Value="#FF5E5B"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="16,9"/>
    </Style>
    <Style Selector="Button.kofi:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FF5E5B"/>
    </Style>
    <Style Selector="Button.kofi:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E04A48"/>
    </Style>
    <Style Selector="Button.discord">
      <Setter Property="Background" Value="#5865F2"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="16,9"/>
    </Style>
    <Style Selector="Button.discord:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#5865F2"/>
    </Style>
    <Style Selector="Button.discord:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4752C4"/>
    </Style>
    <Style Selector="Border.accentTile">
      <Setter Property="Background" Value="{StaticResource XlaAccentBrush}"/>
    </Style>
    <Style Selector="Border.successTile">
      <Setter Property="Background" Value="#1E6B35"/>
    </Style>
    <!-- Home's Login pill: gradient + glow on the Border, the Button inside transparent. -->
    <Style Selector="Border.loginPill">
      <Setter Property="CornerRadius" Value="34"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Offset="0" Color="#6FA8FF"/>
          <GradientStop Offset="0.55" Color="#4C8DFF"/>
          <GradientStop Offset="1" Color="#2F63D6"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="BoxShadow" Value="0 6 22 0 #664C8DFF"/>
    </Style>
    <Style Selector="Button.loginPill">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="34"/>
      <Setter Property="Padding" Value="0,13"/>
      <Setter Property="MinHeight" Value="68"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.loginPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.loginPill:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#26000000"/>
    </Style>
    <Style Selector="Button.loginPill:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>
    <!-- Login page variant: one line, so a shorter pill. Dimmed while logging in. -->
    <Style Selector="Border.loginPill.compact">
      <Setter Property="CornerRadius" Value="26"/>
      <Setter Property="BoxShadow" Value="0 5 18 0 #554C8DFF"/>
    </Style>
    <Style Selector="Button.loginPill.compact">
      <Setter Property="CornerRadius" Value="26"/>
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="Padding" Value="0,14"/>
    </Style>
    <Style Selector="Border.loginPill.busy">
      <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <!-- Banner position dots; the current one widens into a white bar. -->
    <Style Selector="Border.bannerDot">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Height" Value="6"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Background" Value="#80FFFFFF"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.bannerDot.current">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Background" Value="White"/>
    </Style>

    <!-- Each page fades and slides up a little when it is opened. -->
    <Style Selector=":is(Control).page[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="0:0:0.22" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="TranslateTransform.Y" Value="14"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="TranslateTransform.Y" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Small rounded status pills on Home. -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="#1AFFFFFF"/>
      <Setter Property="BorderBrush" Value="#22FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="4,4"/>
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="#C8D4F0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- One headline row: optional tag chip (Maintenance, Recovery, Important…), title, date. -->
    <DataTemplate x:Key="NewsRow" x:DataType="vm:NewsItem">
      <Button Background="Transparent" BorderThickness="0" Padding="10,8" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch" Command="{Binding OpenCommand}">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasTag}"
                      Margin="0,0,0,3">
            <Border Background="{StaticResource XlaAccentBrush}" CornerRadius="4" Padding="6,1">
              <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
            </Border>
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Title}" FontSize="13.5" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Classes="dim" Text="{Binding Date}" FontSize="12"
                     VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="*,Auto" Background="{StaticResource XlaGroundBrush}">

    <!-- ================================ Home ================================ -->
    <ScrollViewer Grid.Row="0" Classes="page" IsVisible="{Binding IsHomePage}">
      <StackPanel>
        <!-- Hero: sky, title, banners (or the crystal) -->
        <Grid Height="270" ClipToBounds="True">
          <views:SkyBackdrop/>
          <!-- The banner on show, blurred and faded out downwards, as the header's artwork. -->
          <Image Source="{Binding News.CurrentBanner.Image}" Stretch="UniformToFill" Margin="-40"
                 Opacity="0.45" IsVisible="{Binding News.HasBanners}" IsHitTestVisible="False">
            <Image.Effect>
              <BlurEffect Radius="30"/>
            </Image.Effect>
            <Image.OpacityMask>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF000000"/>
                <GradientStop Offset="0.6" Color="#B0000000"/>
                <GradientStop Offset="1" Color="#00000000"/>
              </LinearGradientBrush>
            </Image.OpacityMask>
            <Image.Transitions>
              <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.4"/></Transitions>
            </Image.Transitions>
          </Image>
          <!-- The crystal takes the banner's place whenever there is none (turned off, still loading, or offline). -->
          <views:CrystalLogo Width="105" Height="149" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                             Margin="0,0,0,14" IsVisible="{Binding !News.HasBanners}"/>
          <StackPanel Margin="0,28,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="2">
            <TextBlock Text="XIVLauncher" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Static loc:Strings.Home_Subtitle}" FontSize="14" Foreground="#C8D4F0"
                       HorizontalAlignment="Center"/>
          </StackPanel>
          <!-- Official launcher banners under the title, one at a time: tap the left or right edge to step
               (wraps around), tap the middle to open it. -->
          <Grid IsVisible="{Binding News.HasBanners}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="16,0,16,14" Height="150">
            <Button Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding News.OpenBannerCommand}">
              <Border CornerRadius="10" ClipToBounds="True">
                <Grid>
                  <!-- The next banner fades in over the last one. -->
                  <TransitioningContentControl Content="{Binding News.CurrentBanner}">
                    <TransitioningContentControl.PageTransition>
                      <CrossFade Duration="0:0:0.45"/>
                    </TransitioningContentControl.PageTransition>
                    <TransitioningContentControl.ContentTemplate>
                      <DataTemplate x:DataType="vm:NewsBanner">
                        <Image Source="{Binding Image}" Height="150" Stretch="Uniform"/>
                      </DataTemplate>
                    </TransitioningContentControl.ContentTemplate>
                  </TransitioningContentControl>
                  <!-- A soft dark edge along the bottom, so the dots read on any banner. -->
                  <Border Height="44" VerticalAlignment="Bottom" IsHitTestVisible="False">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#00000000"/>
                        <GradientStop Offset="1" Color="#99000000"/>
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                </Grid>
              </Border>
            </Button>
            <Grid ColumnDefinitions="*,2*,*">
              <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="6,0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding News.PreviousBannerCommand}">
                <PathIcon Data="{x:Static views:Icons.ChevronRight}" Width="18" Height="18" Foreground="#CCFFFFFF"
                          RenderTransform="scaleX(-1)"/>
              </Button>
              <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="6,0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Right"
                      Command="{Binding News.NextBannerCommand}">
                <PathIcon Data="{x:Static views:Icons.ChevronRight}" Width="18" Height="18" Foreground="#CCFFFFFF"/>
              </Button>
            </Grid>
            <!-- Which banner is showing: one dot each, the current one stretched into a bar. -->
            <ItemsControl ItemsSource="{Binding News.BannerDots}" HorizontalAlignment="Center"
                          VerticalAlignment="Bottom" Margin="0,0,0,8" IsHitTestVisible="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BannerDot">
                  <Border Classes="bannerDot" Classes.current="{Binding IsCurrent}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Grid>

        <StackPanel Margin="16,4,16,16" Spacing="12" MaxWidth="600">
          <!-- A newer APK has been published. Opens the download in the browser; Android's installer does the rest. -->
          <Button Classes="card" Command="{Binding OpenUpdateCommand}" IsVisible="{Binding IsUpdateAvailable}"
                  BorderBrush="{StaticResource XlaAccentBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="tile accentTile" Margin="0,0,14,0">
                <PathIcon Data="{x:Static views:Icons.CloudDownload}"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{x:Static loc:Strings.Home_UpdateAvailable}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Classes="dim" Text="{Binding UpdateText}" FontSize="12.5" TextWrapping="Wrap"/>
              </StackPanel>
              <PathIcon Grid.Column="2" Classes="chevron" Data="{x:Static views:Icons.ChevronRight}"/>
            </Grid>
          </Button>

          <!-- Only while the game is missing or unreadable: then this card is the way to install or fix it. With the
               game present, its version shows under Play instead. -->
          <Button Classes="card" Classes.missing="{Binding IsGameMissing}" IsVisible="{Binding IsGameMissing}"
                  Command="{Binding NavigateCommand}" CommandParameter="Game">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border Grid.Column="0" Classes="tile" Classes.successTile="{Binding !IsGameMissing}" Margin="0,0,14,0">
                <PathIcon Data="{Binding GameIcon}"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding GameTitle}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Classes="dim" Text="{Binding GameDetail}" FontSize="12.5" TextWrapping="Wrap"/>
              </StackPanel>
              <PathIcon Grid.Column="2" Classes="chevron" Data="{x:Static views:Icons.ChevronRight}"/>
            </Grid>
          </Button>

          <!-- Login: the main action. A blue gradient pill with a soft glow under it so it sits above the dark page,
               a play icon before the label and the short game version under it, all centred. The glow is on the
               Border (a Button's own template has no shadow); the Button inside stays transparent and only
               darkens and shrinks a little while pressed. -->
          <Border Classes="loginPill" IsVisible="{Binding !IsGameMissing}" Margin="0,10,0,0">
            <Button Classes="loginPill" Command="{Binding NavigateCommand}" CommandParameter="Login">
              <StackPanel HorizontalAlignment="Center" Spacing="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                  <PathIcon Data="{x:Static views:Icons.Play}" Width="16" Height="16" Foreground="White"
                            VerticalAlignment="Center"/>
                  <TextBlock Text="{x:Static loc:Strings.Home_Play}" FontSize="18" FontWeight="Bold"
                             Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding PlayDetail}" FontSize="11.5" FontWeight="Light" Foreground="White"
                           Opacity="0.7" HorizontalAlignment="Center" TextAlignment="Center"/>
              </StackPanel>
            </Button>
          </Border>

          <!-- Status chip under Login: the server gate, from the official launcher's check. -->
          <WrapPanel HorizontalAlignment="Center" Margin="0,-2,0,0">
            <Border Classes="chip" IsVisible="{Binding News.HasGateStatus}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8" Fill="#4CD97B" IsVisible="{Binding News.GateOpen}" VerticalAlignment="Center"/>
                <Ellipse Width="8" Height="8" Fill="#E5C07B" IsVisible="{Binding !News.GateOpen}" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static loc:Strings.Home_ServersOnline}" IsVisible="{Binding News.GateOpen}"/>
                <TextBlock Text="{x:Static loc:Strings.Home_Maintenance}" IsVisible="{Binding !News.GateOpen}"/>
              </StackPanel>
            </Border>
          </WrapPanel>



          <!-- News from the official launcher's feeds: banner carousel, then notices, news (maintenance etc.)
               and topics (events). Every entry opens its Lodestone page. -->

          <TextBlock Classes="dim" Text="{x:Static loc:Strings.Home_NewsUnavailable}" FontSize="12.5"
                     IsVisible="{Binding News.ShowFailure}" Margin="4,0"/>

          <TextBlock Classes="caption" Text="{x:Static loc:Strings.Home_Important}" IsVisible="{Binding News.HasPinned}"/>
          <Border Classes="card" Padding="4" IsVisible="{Binding News.HasPinned}">
            <ItemsControl ItemsSource="{Binding News.Pinned}" ItemTemplate="{StaticResource NewsRow}"/>
          </Border>

          <TextBlock Classes="caption" Text="{x:Static loc:Strings.Home_News}" IsVisible="{Binding News.HasNews}"/>
          <Border Classes="card" Padding="4" IsVisible="{Binding News.HasNews}">
            <ItemsControl ItemsSource="{Binding News.News}" ItemTemplate="{StaticResource NewsRow}"/>
          </Border>

          <TextBlock Classes="caption" Text="{x:Static loc:Strings.Home_Topics}" IsVisible="{Binding News.HasTopics}"/>
          <Border Classes="card" Padding="4" IsVisible="{Binding News.HasTopics}">
            <ItemsControl ItemsSource="{Binding News.Topics}" ItemTemplate="{StaticResource NewsRow}"/>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ================================ Login ================================ -->
    <Grid Grid.Row="0" Classes="page" IsVisible="{Binding IsLoginPage}">
      <views:SkyBackdrop/>
      <!-- ScrollViewer so the fields stay reachable when the soft keyboard covers half the screen. -->
      <ScrollViewer>
        <StackPanel HorizontalAlignment="Stretch" Spacing="6" Margin="24,36,24,0" MaxWidth="420">
          <!-- The back button sits over the page (below) in the top-left corner; the column starts under it. Kept tight so a phone shows the whole
               form down to the Log in button without scrolling. -->
          <views:CrystalLogo Width="70" Height="99" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          <TextBlock Text="XIVLauncher" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="{x:Static loc:Strings.Login_Intro}" Foreground="#C8D4F0"
                     HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>

          <TextBlock Classes="caption" Text="{x:Static loc:Strings.Login_Username}"/>
          <Grid>
            <TextBox Text="{Binding Username}" IsEnabled="{Binding !IsBusy}" Padding="44,12,12,12"/>
            <PathIcon Data="{x:Static views:Icons.Person}" Width="18" Height="18" Margin="14,0,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                      Foreground="{StaticResource XlaTextDimBrush}"/>
          </Grid>

          <TextBlock Classes="caption" Text="{x:Static loc:Strings.Login_Password}" Margin="4,8,0,6"/>
          <Grid>
            <TextBox x:Name="PasswordBox" PasswordChar="•" RevealPassword="{Binding ShowPassword}"
                     Text="{Binding Password}" IsEnabled="{Binding !IsBusy}" Padding="44,12,48,12"/>
            <PathIcon Data="{x:Static views:Icons.Lock}" Width="18" Height="18" Margin="14,0,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                      Foreground="{StaticResource XlaTextDimBrush}"/>
            <Button Classes="icon" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                    Command="{Binding ToggleShowPasswordCommand}">
              <PathIcon Data="{x:Static views:Icons.Eye}" Width="20" Height="20"
                        Foreground="{StaticResource XlaTextDimBrush}"/>
            </Button>
          </Grid>

          <Button Classes="check" Command="{Binding ToggleUseOtpCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="box" Classes.checked="{Binding UseOtp}">
                <Path Classes="tick" IsVisible="{Binding UseOtp}"/>
              </Border>
              <TextBlock Text="{x:Static loc:Strings.Login_UseOtp}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Classes="check" Command="{Binding ToggleIsSteamAccountCommand}" IsEnabled="{Binding !IsBusy}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="box" Classes.checked="{Binding IsSteamAccount}">
                <Path Classes="tick" IsVisible="{Binding IsSteamAccount}"/>
              </Border>
              <TextBlock Text="{x:Static loc:Strings.Login_SteamAccount}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock Classes="dim" Text="{Binding SteamStatus}" TextWrapping="Wrap" FontSize="12.5"
                     Margin="36,-4,0,0" IsVisible="{Binding IsSteamAccount}"/>

          <!-- Shown for every account: the lobby checks the trial entitlement whatever the platform. -->
          <Button Classes="check" Command="{Binding ToggleIsFreeTrialCommand}" IsEnabled="{Binding !IsBusy}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="box" Classes.checked="{Binding IsFreeTrial}">
                <Path Classes="tick" IsVisible="{Binding IsFreeTrial}"/>
              </Border>
              <TextBlock Text="{x:Static loc:Strings.Login_FreeTrial}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Classes="check" Command="{Binding ToggleRememberLoginCommand}" IsEnabled="{Binding !IsBusy}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="box" Classes.checked="{Binding RememberLogin}">
                <Path Classes="tick" IsVisible="{Binding RememberLogin}"/>
              </Border>
              <TextBlock Text="{x:Static loc:Strings.Login_Remember}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Same gradient pill as Home's Login, so the two pages match. -->
          <Border Classes="loginPill compact" Classes.busy="{Binding IsBusy}" Margin="0,14,0,0">
            <Button Classes="loginPill compact" Command="{Binding LoginAndPlayCommand}" IsEnabled="{Binding !IsBusy}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <PathIcon Data="{x:Static views:Icons.Play}" Width="15" Height="15" Foreground="White"
                          VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static loc:Strings.Login_Button}" FontSize="16" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Border>

          <ProgressBar IsIndeterminate="True" Height="4" Margin="40,6,40,0" IsVisible="{Binding IsBusy}"/>
          <TextBlock Text="{Binding Greeting}" HorizontalAlignment="Center" TextAlignment="Center"
                     TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#C8D4F0"/>
        </StackPanel>
      </ScrollViewer>
      <Button Classes="icon" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0"
              Command="{Binding NavigateCommand}" CommandParameter="Home" IsEnabled="{Binding !IsBusy}">
        <PathIcon Data="{x:Static views:Icons.ArrowBack}"/>
      </Button>
    </Grid>

    <!-- ================================ Settings ================================ -->
    <!-- The Border keeps MainViewModel as its DataContext so the visibility binding resolves. -->
    <Border Grid.Row="0" Classes="page" IsVisible="{Binding IsSettingsPage}">
      <views:SettingsView DataContext="{Binding Settings}"/>
    </Border>

    <!-- ================================ Logs ================================ -->
    <Grid Grid.Row="0" Classes="page" RowDefinitions="Auto,Auto,Auto,*" Background="{StaticResource XlaPageBrush}"
          IsVisible="{Binding IsLogsPage}">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="18,18,10,4">
        <Border Grid.Column="0" Classes="tile" Width="46" Height="46" Margin="0,0,12,0">
          <PathIcon Data="{x:Static views:Icons.Logs}"/>
        </Border>
        <TextBlock Grid.Column="1" Classes="h1" Text="{x:Static loc:Strings.Logs_Title}" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Classes="icon" Command="{Binding Logs.ReloadCommand}">
          <PathIcon Data="{x:Static views:Icons.Refresh}"/>
        </Button>
        <Button Grid.Column="3" Classes="icon" Click="CopyLog" IsEnabled="{Binding Logs.HasSources}">
          <PathIcon Data="{x:Static views:Icons.Copy}"/>
        </Button>
        <!-- Zips every log for a bug report and asks where to save it. -->
        <Button Grid.Column="4" Classes="icon" Command="{Binding Logs.ExportCommand}">
          <PathIcon Data="{x:Static views:Icons.Download}"/>
        </Button>
      </Grid>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    Margin="8,6,8,0">
        <ItemsControl ItemsSource="{Binding Logs.Sources}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LogSource">
              <Button Classes="tab" Classes.selected="{Binding IsSelected}" Content="{Binding Label}"
                      Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Logs.SelectCommand}"
                      CommandParameter="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Classes="dim" Text="{Binding Logs.Detail}" FontSize="11.5" TextWrapping="Wrap"
                 Margin="18,8,18,8"/>
      <Border Grid.Row="3" Classes="card" Margin="12,0,12,12" Padding="0" IsVisible="{Binding Logs.HasSources}">
        <!-- One screen row per item, virtualized: only the rows on screen exist. LogsViewModel cuts long lines to
             the width (MainView sets Columns), so every row has the same height and the scroll bar stays steady.
             Copy (top right) takes the whole log, so per-line text selection is not needed here. -->
        <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnLogScrollSizeChanged">
          <ItemsControl ItemsSource="{Binding Logs.Lines}" Margin="12,10">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LogLine">
                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontFamily="monospace"
                           FontSize="11" TextWrapping="NoWrap" Height="15"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ================================ About ================================ -->
    <Grid Grid.Row="0" Classes="page" IsVisible="{Binding IsAboutPage}">
      <views:SkyBackdrop/>
      <ScrollViewer>
        <StackPanel Margin="20,12,20,24" Spacing="10" MaxWidth="480">
          <views:CrystalLogo Width="96" Height="136" HorizontalAlignment="Center"/>
          <TextBlock Text="XIVLauncher" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="{x:Static loc:Strings.About_Subtitle}" FontSize="17" HorizontalAlignment="Center" Foreground="#C8D4F0" Margin="0,-6,0,0"/>
          <TextBlock Text="{x:Static loc:Strings.About_Intro}"
                     Foreground="#C8D4F0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     Margin="0,4,0,10"/>

          <Border Classes="card" Padding="16,6">
            <StackPanel>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10">
                <PathIcon Data="{x:Static views:Icons.Info}" Width="18" Height="18" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.About_Version}"/>
                <TextBlock Grid.Column="2" Classes="dim" Text="{Binding VersionText}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10">
                <PathIcon Data="{x:Static views:Icons.Code}" Width="18" Height="18" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.About_BuiltWith}"/>
                <TextBlock Grid.Column="2" Classes="dim" Text="Avalonia · .NET"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10">
                <PathIcon Data="{x:Static views:Icons.Chip}" Width="18" Height="18" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.About_RunsOn}"/>
                <TextBlock Grid.Column="2" Classes="dim" Text="Wine · FEX · DXVK · Turnip" TextAlignment="End"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="16,14">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{x:Static views:Icons.Heart}" Width="18" Height="18" Foreground="#E06C75"/>
                <TextBlock Text="{x:Static loc:Strings.About_Thanks}" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock Classes="dim" FontSize="12.5" TextWrapping="Wrap"
                         Text="{x:Static loc:Strings.About_ThanksText}"/>
            </StackPanel>
          </Border>

          <!-- Support the port: its own row, deliberately outside the credits card. Opens Ko-fi in the browser. -->
          <Button Classes="kofi" Command="{Binding OpenKofiCommand}" HorizontalAlignment="Center" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static views:Icons.Coffee}" Width="18" Height="18" Foreground="White"/>
              <TextBlock Text="{x:Static loc:Strings.About_Coffee}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Opens the Discord server in the browser. -->
          <Button Classes="discord" Command="{Binding OpenDiscordCommand}" HorizontalAlignment="Center" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{x:Static views:Icons.Discord}" Width="18" Height="18" Foreground="White"/>
              <TextBlock Text="{x:Static loc:Strings.About_Discord}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <TextBlock Classes="dim" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="8,10,8,0"
                     Text="{x:Static loc:Strings.About_Legal}"/>
          <TextBlock Text="{x:Static loc:Strings.About_Tagline}" HorizontalAlignment="Center" Foreground="#C8D4F0"
                     Margin="0,14,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ================================ Bottom navigation ================================ -->
    <Border Grid.Row="1" IsVisible="{Binding ShowBottomNav}" Background="#0A1022"
            BorderBrush="{StaticResource XlaCardBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,4">
        <Button Grid.Column="0" Classes="nav" Classes.selected="{Binding IsHomePage}"
                Command="{Binding NavigateCommand}" CommandParameter="Home">
          <StackPanel Spacing="3" HorizontalAlignment="Center">
            <PathIcon Data="{x:Static views:Icons.Home}" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Static loc:Strings.Nav_Home}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="nav" Classes.selected="{Binding IsSettingsPage}"
                Command="{Binding NavigateCommand}" CommandParameter="Settings">
          <StackPanel Spacing="3" HorizontalAlignment="Center">
            <PathIcon Data="{x:Static views:Icons.Settings}" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Static loc:Strings.Nav_Settings}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="nav" Classes.selected="{Binding IsLogsPage}"
                Command="{Binding NavigateCommand}" CommandParameter="Logs">
          <StackPanel Spacing="3" HorizontalAlignment="Center">
            <PathIcon Data="{x:Static views:Icons.Logs}" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Static loc:Strings.Logs_Title}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Classes="nav" Classes.selected="{Binding IsAboutPage}"
                Command="{Binding NavigateCommand}" CommandParameter="About">
          <StackPanel Spacing="3" HorizontalAlignment="Center">
            <PathIcon Data="{x:Static views:Icons.Info}" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Static loc:Strings.Home_About}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- First-run setup. Covers everything until the runtime is installed. -->
    <Border Grid.RowSpan="2" IsVisible="{Binding Setup.IsOpen}">
      <views:SetupView DataContext="{Binding Setup}"/>
    </Border>

    <!-- Game install / update progress. -->
    <Border Grid.RowSpan="2" IsVisible="{Binding Install.IsOpen}">
      <views:InstallView DataContext="{Binding Install}"/>
    </Border>

    <!-- One-time password prompt, opened by Log in & Play when "Use one-time password" is checked. -->
    <Border Grid.RowSpan="2" IsVisible="{Binding IsOtpPromptOpen}" Background="#B0000000">
      <Border Classes="dialog" MaxWidth="380">
        <StackPanel Spacing="12">
          <TextBlock Text="{x:Static loc:Strings.Otp_Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Classes="dim" Text="{x:Static loc:Strings.Otp_Detail}" TextWrapping="Wrap"/>
          <TextBox x:Name="OtpBox" Text="{Binding Otp}" MaxLength="6" FontSize="24" HorizontalContentAlignment="Center"
                   TextInputOptions.ContentType="Digits">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SubmitOtpCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>
          <TextBlock Text="{Binding OtpError}" Foreground="{StaticResource XlaDangerBrush}"
                     IsVisible="{Binding OtpError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <Grid ColumnDefinitions="*,12,*" Margin="0,4,0,0">
            <Button Grid.Column="0" Classes="secondary" Content="{x:Static loc:Strings.Common_Cancel}" Command="{Binding CancelOtpCommand}"
                    HorizontalAlignment="Stretch"/>
            <Button Grid.Column="2" Classes="primary" Content="{x:Static loc:Strings.Common_LogIn}" Command="{Binding SubmitOtpCommand}"
                    Padding="0,11"/>
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- Steam sign-in, for a Steam service account's login or the Lossless Scaling download, only when there is
         no usable saved Steam session; the password is handed straight to Steam and never stored. -->
    <Border Grid.RowSpan="2" IsVisible="{Binding IsSteamSignInOpen}" Background="#B0000000">
      <Border Classes="dialog" MaxWidth="400">
        <StackPanel Spacing="12">
          <TextBlock Text="{x:Static loc:Strings.Steam_SignInTitle}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Classes="dim" TextWrapping="Wrap"
                     Text="{Binding SteamSignInReason}"/>

          <TextBlock Classes="caption" Text="{x:Static loc:Strings.Steam_AccountName}"/>
          <TextBox Text="{Binding SteamAccountInput}"/>

          <TextBlock Classes="caption" Text="{x:Static loc:Strings.Steam_Password}" Margin="4,4,0,6"/>
          <Grid>
            <TextBox x:Name="SteamPasswordBox" PasswordChar="&#x2022;" RevealPassword="{Binding ShowSteamPassword}"
                     Text="{Binding SteamPasswordInput}" Padding="12,12,48,12">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SubmitSteamSignInCommand}"/>
              </TextBox.KeyBindings>
            </TextBox>
            <Button Classes="icon" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                    Command="{Binding ToggleShowSteamPasswordCommand}">
              <PathIcon Data="{x:Static views:Icons.Eye}" Width="20" Height="20"
                        Foreground="{StaticResource XlaTextDimBrush}"/>
            </Button>
          </Grid>

          <TextBlock Text="{Binding SteamSignInError}" Foreground="{StaticResource XlaDangerBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding SteamSignInError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <Grid ColumnDefinitions="*,12,*" Margin="0,4,0,0">
            <Button Grid.Column="0" Classes="secondary" Content="{x:Static loc:Strings.Common_Cancel}" Command="{Binding CancelSteamSignInCommand}"
                    HorizontalAlignment="Stretch"/>
            <Button Grid.Column="2" Classes="primary" Content="{x:Static loc:Strings.Steam_SignIn}" Command="{Binding SubmitSteamSignInCommand}"
                    Padding="0,11"/>
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- Steam Guard: either waiting for the push in the Steam mobile app, or asking for a code. -->
    <Border Grid.RowSpan="2" IsVisible="{Binding IsSteamGuardOpen}" Background="#B0000000">
      <Border Classes="dialog" MaxWidth="380">
        <StackPanel Spacing="12">
          <TextBlock Text="Steam Guard" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Classes="dim" Text="{Binding SteamGuardDetail}" TextWrapping="Wrap"/>

          <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,0,0" IsVisible="{Binding IsSteamGuardWaiting}"/>

          <TextBox Text="{Binding SteamGuardCode}" MaxLength="5" FontSize="24" HorizontalContentAlignment="Center"
                   IsVisible="{Binding !IsSteamGuardWaiting}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SubmitSteamGuardCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>

          <TextBlock Text="{Binding SteamGuardError}" Foreground="{StaticResource XlaDangerBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding SteamGuardError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

          <Grid ColumnDefinitions="*,12,*" Margin="0,4,0,0" IsVisible="{Binding !IsSteamGuardWaiting}">
            <Button Grid.Column="0" Classes="secondary" Content="{x:Static loc:Strings.Common_Cancel}" Command="{Binding CancelSteamGuardCommand}"
                    HorizontalAlignment="Stretch"/>
            <Button Grid.Column="2" Classes="primary" Content="{x:Static loc:Strings.Common_Continue}" Command="{Binding SubmitSteamGuardCommand}"
                    Padding="0,11"/>
          </Grid>

          <!-- Stacked rather than side by side: "Enter a code instead" does not fit a half-width button. -->
          <StackPanel Spacing="10" Margin="0,4,0,0" IsVisible="{Binding IsSteamGuardWaiting}">
            <Button Classes="secondary" Content="{x:Static loc:Strings.Steam_EnterCodeInstead}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Command="{Binding UseSteamGuardCodeCommand}"/>
            <Button Classes="secondary" Content="{x:Static loc:Strings.Common_Cancel}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Command="{Binding CancelSteamGuardCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- No game installed: the two ways out are "download it" and "I already have it". -->
    <Border Grid.RowSpan="2" IsVisible="{Binding IsNoGamePromptOpen}" Background="#B0000000">
      <Border Classes="dialog" MaxWidth="400">
        <StackPanel Spacing="12">
          <TextBlock Text="{x:Static loc:Strings.NoGame_Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Classes="dim" Text="{Binding NoGameDetail}" TextWrapping="Wrap"/>
          <TextBlock Text="{x:Static loc:Strings.NoGame_Question}" TextWrapping="Wrap"/>
          <TextBlock Classes="dim" TextWrapping="Wrap" FontSize="12.5"
                     Text="{x:Static loc:Strings.NoGame_Hint}"/>
          <Grid ColumnDefinitions="*,12,*" Margin="0,4,0,0">
            <Button Grid.Column="0" Classes="secondary" Content="{x:Static loc:Strings.NoGame_No}" Command="{Binding ChooseGameFolderCommand}"
                    HorizontalAlignment="Stretch"/>
            <Button Grid.Column="2" Classes="primary" Content="{x:Static loc:Strings.NoGame_Yes}" Command="{Binding InstallGameCommand}"
                    Padding="0,11"/>
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
