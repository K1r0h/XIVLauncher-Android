<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XlaBoot.ViewModels"
             xmlns:views="using:XlaBoot.Views"
             x:Class="XlaBoot.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <!-- Every setting is a card Button that flips its value, lists its options under itself, or opens a picker: no
       ComboBox popups (awkward on a phone) and no CheckBox/ToggleButton, which crashes Avalonia.Android as soon as
       an accessibility client reads it. Card, tile and tab styles live in Styles/Theme.axaml. -->
  <UserControl.Styles>
    <Style Selector="Button.card.warning TextBlock.title, Button.card.warning TextBlock.value">
      <Setter Property="Foreground" Value="{StaticResource XlaDangerBrush}"/>
    </Style>
    <Style Selector="Button.card.warning Border.tile > PathIcon">
      <Setter Property="Foreground" Value="{StaticResource XlaDangerBrush}"/>
    </Style>

    <!-- A dropdown row's chevron points down, and up while its options are showing. -->
    <Style Selector="PathIcon.chevron.dropdown">
      <Setter Property="RenderTransform" Value="rotate(90deg)"/>
    </Style>
    <Style Selector="PathIcon.chevron.dropdown.open">
      <Setter Property="RenderTransform" Value="rotate(-90deg)"/>
    </Style>

    <!-- An option under an open dropdown: a slimmer card, indented under its row. -->
    <Style Selector="Button.card.option">
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="Button.card.option.selected TextBlock">
      <Setter Property="Foreground" Value="{StaticResource XlaAccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.trash">
      <Setter Property="Background" Value="#C94F4F"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style Selector="Button.trash:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C94F4F"/>
    </Style>
    <Style Selector="Button.trash:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#A83E3E"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{StaticResource XlaPageBrush}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" MaxWidth="600" HorizontalAlignment="Stretch" Margin="16,8,16,0">

      <!-- Header -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="2,10,0,4">
        <Border Classes="tile" Width="46" Height="46">
          <PathIcon Data="{x:Static views:Icons.Settings}"/>
        </Border>
        <TextBlock Classes="h1" Text="Settings" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Tabs scroll sideways when four don't fit (Dalamud Repos only shows while Dalamud is on). -->
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    Margin="0,8,0,4">
        <StackPanel Orientation="Horizontal">
          <Button Classes="tab" Classes.selected="{Binding IsGeneralTab}" Content="General"
                  Command="{Binding SelectTabCommand}" CommandParameter="0"/>
          <Button Classes="tab" Classes.selected="{Binding IsGraphicsTab}" Content="Graphics"
                  Command="{Binding SelectTabCommand}" CommandParameter="1"/>
          <Button Classes="tab" Classes.selected="{Binding IsAdvancedTab}" Content="Advanced"
                  Command="{Binding SelectTabCommand}" CommandParameter="2"/>
          <Button Classes="tab" Classes.selected="{Binding IsReposTab}" Content="Dalamud Repos"
                  Command="{Binding SelectTabCommand}" CommandParameter="3" IsVisible="{Binding ShowReposTab}"/>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Row="2">
        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,0,0,12">
          <ItemsControl.DataTemplates>

            <DataTemplate DataType="vm:SettingsHeader">
              <TextBlock Classes="section" Text="{Binding Title}"/>
            </DataTemplate>

            <DataTemplate DataType="vm:SettingsRow">
              <Button Classes="card" Classes.warning="{Binding IsWarning}" Command="{Binding Tap}"
                      IsEnabled="{Binding IsAvailable}" Margin="0,0,0,10">
                <!-- The detail gets a row of its own across the full width. Beside the value it was squeezed
                     into whatever a long value (Mailbox (low latency)) left, a word or two per line. -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                  <Border Grid.Column="0" Grid.RowSpan="2" Classes="tile" Margin="0,0,14,0" VerticalAlignment="Top">
                    <PathIcon Data="{Binding Icon}"/>
                  </Border>
                  <TextBlock Grid.Column="1" Classes="title" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                             TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Classes="dim" Text="{Binding Detail}"
                             FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"
                             IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <TextBlock Grid.Column="2" Classes="value" Text="{Binding Value}" FontSize="14"
                             Margin="12,2,4,0" VerticalAlignment="Top" TextAlignment="End" MaxWidth="150"
                             TextWrapping="Wrap" Foreground="{StaticResource XlaAccentBrush}"
                             IsVisible="{Binding Value, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <PathIcon Grid.Column="3" Classes="chevron" Classes.dropdown="{Binding IsDropdown}"
                            Classes.open="{Binding IsExpanded}" Data="{x:Static views:Icons.ChevronRight}"
                            VerticalAlignment="Top" Margin="0,3,0,0"/>
                </Grid>
              </Button>
            </DataTemplate>

            <DataTemplate DataType="vm:SettingsOption">
              <Button Classes="card option" Classes.selected="{Binding IsSelected}" Command="{Binding Pick}"
                      Margin="28,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="15" TextWrapping="Wrap"
                             VerticalAlignment="Center"/>
                  <PathIcon Grid.Column="1" Width="20" Height="20" Margin="12,0,0,0"
                            Foreground="{StaticResource XlaAccentBrush}" Data="{x:Static views:Icons.CheckCircle}"
                            IsVisible="{Binding IsSelected}"/>
                </Grid>
              </Button>
            </DataTemplate>

            <!-- A custom Dalamud repo: the link, and a red trash button that removes it with one tap. -->
            <DataTemplate DataType="vm:RepoRow">
              <Border Classes="card" Padding="14,10" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Url}" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock Classes="dim" Text="{Binding Title}" FontSize="11.5" IsVisible="{Binding !IsEnabled}"/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="trash" Command="{Binding Delete}" Margin="12,0,0,0"
                          VerticalAlignment="Center">
                    <PathIcon Width="18" Height="18" Foreground="White" Data="{x:Static views:Icons.Delete}"/>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>

            <!-- "Add repo": paste a link, Add (or Enter) to save it. A refused link keeps it open with the reason. -->
            <DataTemplate DataType="vm:RepoInputRow">
              <Border Classes="card" Padding="14" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                  <TextBox Classes="repoInput" Text="{Binding Text}" Watermark="https://…/repo.json"
                           TextInputOptions.ContentType="Url">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding Confirm}"/>
                    </TextBox.KeyBindings>
                  </TextBox>
                  <TextBlock Text="{Binding Error}" FontSize="12.5" Foreground="{StaticResource XlaDangerBrush}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <Grid ColumnDefinitions="*,12,*">
                    <Button Grid.Column="0" Classes="secondary" Content="Cancel" Command="{Binding Cancel}"
                            HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="2" Classes="primary" Content="Add" Command="{Binding Confirm}" Padding="0,11"/>
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>

          </ItemsControl.DataTemplates>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="3" Margin="4,4,4,10" Spacing="4">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Classes="dim" Text="These apply the next time you launch the game." FontSize="12"
                   TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
