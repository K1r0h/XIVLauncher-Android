<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash animation (Android 12+): the crystal settles in with a slight grow, its glow swells, and the
     sparkle on top twinkles in. Runs while the app starts; the static crystal_splash is the same art. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/crystal_splash">
  <target android:name="crystal">
    <aapt:attr name="android:animation">
      <set>
        <objectAnimator android:propertyName="scaleX" android:valueFrom="0.82" android:valueTo="1"
            android:duration="700" android:interpolator="@android:interpolator/overshoot"/>
        <objectAnimator android:propertyName="scaleY" android:valueFrom="0.82" android:valueTo="1"
            android:duration="700" android:interpolator="@android:interpolator/overshoot"/>
      </set>
    </aapt:attr>
  </target>
  <target android:name="glow">
    <aapt:attr name="android:animation">
      <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1"
          android:duration="900" android:interpolator="@android:interpolator/decelerate_cubic"/>
    </aapt:attr>
  </target>
  <target android:name="sparkle">
    <aapt:attr name="android:animation">
      <set>
        <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1"
            android:startOffset="450" android:duration="450" android:interpolator="@android:interpolator/overshoot"/>
        <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1"
            android:startOffset="450" android:duration="450" android:interpolator="@android:interpolator/overshoot"/>
        <objectAnimator android:propertyName="rotation" android:valueFrom="-90" android:valueTo="0"
            android:startOffset="450" android:duration="450" android:interpolator="@android:interpolator/decelerate_cubic"/>
      </set>
    </aapt:attr>
  </target>
</animated-vector>
